# Copiar este archivo a .env (copy .env.example .env  /  cp .env.example .env).
# El .env NO se versiona (está en .gitignore); este archivo sí.
# Con SQLite no hay credenciales: estos valores sirven tal cual.

# Motor de base de datos (por ahora: sqlite)
DB_MOTOR=sqlite
# Archivo de la base
DB_NOMBRE=ecotech.db

# Solo para MySQL / PostgreSQL: se completan en el .env local, nunca aquí.
DB_HOST=
DB_USUARIO=
DB_PASSWORD=

# ---------------- Unidad 3: servicios externos ----------------
# Deben ser HTTPS. Para probar el manejo de errores basta con cambiar la URL en el .env
# (ej: API_INDICADORES_URL=https://mindicador.cl/api/no-existe  -> HTTP 404 -> Plan B).
API_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
API_CLIMA_URL=https://api.open-meteo.com/v1
API_INDICADORES_URL=https://mindicador.cl/api

# Segundos para conectar / para recibir la respuesta, y reintentos (3 a 4 como máximo).
API_TIMEOUT_CONEXION=3.05
API_TIMEOUT_LECTURA=10
API_MAX_INTENTOS=3

# Open-Meteo y mindicador no piden clave para uso no comercial.
# Si se contrata el plan comercial de Open-Meteo, la clave va SOLO en el .env local.
OPEN_METEO_API_KEY=

# Minutos sin actividad antes de que la sesión expire.
SESION_MINUTOS=15
